{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignaciolarranaga.github.io/open-commerce-index/schemas/index.schema.json",
  "title": "OpenCommerceIndex root index",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "schema_version", "taxonomy_version", "generated_at", "source_revision", "base_url", "license", "countries", "categories_url", "store_schema_url", "shards"],
  "properties": {
    "name": { "const": "OpenCommerceIndex" },
    "schema_version": { "type": "integer" },
    "taxonomy_version": { "type": "integer" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_revision": { "type": "string" },
    "base_url": { "type": "string", "pattern": "^https://" },
    "license": { "type": "string" },
    "usage": { "type": "string" },
    "categories_url": { "type": "string", "pattern": "^https://" },
    "store_schema_url": { "type": "string", "pattern": "^https://" },
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["country", "name", "store_count", "url", "categories"],
        "properties": {
          "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "name": { "type": "object" },
          "store_count": { "type": "integer", "minimum": 0 },
          "url": { "type": "string", "pattern": "^https://" },
          "categories": { "type": "object", "additionalProperties": { "type": "integer" } }
        }
      }
    },
    "shards": {
      "description": "Slices of a country file, so an assistant fetches only the part it needs. Empty when no country file is split.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["country", "kind", "id", "url", "store_count"],
        "properties": {
          "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
          "kind": { "description": "city: stores that deliver to or are based in the city. nationwide: stores that deliver across the country. category: stores in one category.", "enum": ["city", "nationwide", "category"] },
          "id": { "description": "City id, or category id, as the kind says. nationwide for the nationwide shard.", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
          "url": { "type": "string", "pattern": "^https://" },
          "store_count": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
