{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ignaciolarranaga.github.io/open-commerce-index/schemas/countries.schema.json",
  "title": "OpenCommerceIndex country registry",
  "description": "The countries the index covers, with their subdivisions and the cities a shopper can name. Store manifests refer to these codes and ids.",
  "type": "object",
  "additionalProperties": false,
  "required": ["countries"],
  "properties": {
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["country", "names", "languages", "currencies", "status", "notes", "regions", "cities"],
        "properties": {
          "country": { "description": "Home country, ISO 3166-1 alpha-2, uppercase.", "type": "string", "pattern": "^[A-Z]{2}$" },
          "names": {
            "type": "object",
            "properties": {
              "en": { "type": "string", "minLength": 1 },
              "es": { "type": "string", "minLength": 1 }
            },
            "required": ["en", "es"],
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "languages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" } },
          "currencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{3}$" } },
          "status": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "maxLength": 600 },
          "regions": {
            "description": "ISO 3166-2 subdivisions that stores may name in ships_to.regions.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "name"],
              "properties": {
                "code": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$" },
                "name": { "type": "string", "minLength": 1 }
              }
            }
          },
          "cities": {
            "description": "Major cities a shopper may name. The id is the slug used in store manifests and in city shard file names; region is the ISO 3166-2 subdivision the city sits in and must appear in regions.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "names", "region"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60 },
                "names": {
                  "type": "object",
                  "properties": {
                    "en": { "type": "string", "minLength": 1 },
                    "es": { "type": "string", "minLength": 1 }
                  },
                  "required": ["en", "es"],
                  "additionalProperties": { "type": "string", "minLength": 1 }
                },
                "region": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$" }
              }
            }
          }
        }
      }
    }
  }
}
